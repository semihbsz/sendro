    android:height="24dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:pivotX="512"
        android:pivotY="512"
        android:scaleX="0.86"
        android:scaleY="0.86">
        <path
            android:pathData="M 252,708 C 560,708 452,316 700,316"
            android:strokeWidth="88"
            android:strokeLineCap="round"
            android:strokeColor="#FFFFFFFF" />

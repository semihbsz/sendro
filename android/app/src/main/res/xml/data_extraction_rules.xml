<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing about Sendro is backed up or transferred to a new device: the
  device token is a per-pairing credential (PROTOCOL.md §3) and received
  files are the user's originals. Re-pair on a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
